# Adresse von Immich im Docker-Netz (Service-Name:Port)
IMMICH_URL=http://immich-server:2283

# Ein API-Key pro Benutzer: IMMICH_KEY_<NAME>=... (beliebig viele, Name klein geschrieben im Tool)
IMMICH_KEY_FRANK=
IMMICH_KEY_JULIA=

# Album für nicht behaltene Duplikate (wird pro Benutzer angelegt, falls es fehlt)
REVIEW_ALBUM=Duplikat-Prüfung

# Fotos ohne Ort: Zeitfenster in Stunden (±) und ob externe Bibliotheken geändert werden dürfen
LOCATION_MAX_HOURS=2
LOCATION_INCLUDE_EXTERNAL=false

# Optional: Basic Auth für Oberfläche und API (/healthz bleibt offen). Beide leer = keine Anmeldung
WEB_USER=
WEB_PASSWORD=

# Nur für docker-compose: Name des Immich-Netzes und Port der Oberfläche
IMMICH_NETWORK=immich_default
PFLEGE_PORT=8090
