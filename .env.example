# Diese Datei ist OPTIONAL. Normalerweise wird alles in der Oberfläche eingestellt
# (Zahnrad-Tab) und in data/einstellungen.json gespeichert.
# Was hier gesetzt wird, hat Vorrang und ist in der Oberfläche gesperrt.

# --- nur für docker compose ---
# Name des Docker-Netzes von Immich und Port der Oberfläche
#IMMICH_NETWORK=immich_default
#PFLEGE_PORT=8090

# --- optional: Einstellungen fest vorgeben ---
#IMMICH_URL=http://immich-server:2283
#IMMICH_KEY_FRANK=
#IMMICH_KEY_JULIA=
#REVIEW_ALBUM=Duplikat-Prüfung
#LOCATION_MAX_HOURS=2
#LOCATION_INCLUDE_EXTERNAL=false
#WEB_USER=
#WEB_PASSWORD=
