# Diese Datei ist OPTIONAL. Normalerweise wird alles in der Oberfläche eingestellt
# (Zahnrad-Tab) und in data/einstellungen.json gespeichert.
# Was hier gesetzt wird, hat Vorrang und ist in der Oberfläche gesperrt.

# --- nur für docker compose ---
# Port der Oberfläche
#PFLEGE_PORT=8090

# --- optional: Einstellungen fest vorgeben ---
#IMMICH_URL=http://192.168.1.20:2283
#REVIEW_ALBUM=Duplikat-Prüfung
#LOCATION_MAX_HOURS=2
#LOCATION_INCLUDE_EXTERNAL=false
#WEB_USER=
#WEB_PASSWORD=
#UPDATE_CHECK=true
#UPDATE_WEBHOOK_URL=
#UPDATE_WEBHOOK_SECRET=

# API-Keys der Benutzer bitte in der Oberfläche eintragen. Wer sie unbedingt per Datei
# vorgeben will, legt eine docker-compose.override.yml mit
#   services: { immich-pflege: { environment: { IMMICH_KEY_FRANK: "...", IMMICH_KEY_JULIA: "..." } } }
# an (wird bei Updates nicht überschrieben).
